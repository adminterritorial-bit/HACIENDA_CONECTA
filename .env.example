NODE_ENV=development
PORT=3000

# Seguridad
TRUST_PROXY=false
APP_BASE_URL=http://localhost:3000
AUDIT_HMAC_KEY=replace-with-32-plus-byte-secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Parámetros tributarios configurables por vigencia
TAX_YEAR=2026
UVT_VALUE_COP=0
ICA_MINIMUM_UVT=2
RETEICA_GOODS_MIN_UVT=10
RETEICA_SERVICES_MIN_UVT=4

# Integraciones (no usar MOCK en producción)
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
IDENTITY_PROVIDER=mock

# Producción: configurar proveedor real de pagos, SMS y autenticación/identidad.
