{
  "name": "hacienda-conecta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma tributaria digital de la Secretaría de Hacienda de San Pedro, Valle del Cauca",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "build": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js --minify",
    "build:dev": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js --sourcemap"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.6.1",
    "zod": "^4.1.11",
    "@supabase/supabase-js": "^2.95.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1",
    "esbuild": "^0.25.0",
    "@types/qrcode": "^1.5.5"
  }
}
